# Copy this file to .env and fill in your values.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the ordered list of Gemini models to try (comma-separated).
# The app tries each in order and falls back to the next if one is unavailable
# (rate limited, over capacity, etc). Defaults to:
# gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.6-flash
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# Optional: used to sign the Flask session cookie (any random string)
FLASK_SECRET_KEY=change_me_to_a_random_secret
